+PRESERVED_ENVS = {
+    'math', 'displaymath', 'equation', 'align', 'alignat', 'flalign', 'gather',
+    'multline', 'eqnarray', 'split', 'aligned', 'alignedat', 'gathered',
+    'subequations', 'matrix', 'pmatrix', 'bmatrix', 'Bmatrix', 'vmatrix', 'Vmatrix', 'cases',
